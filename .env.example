# Copy this file to .env and fill in your API key.
# Get a free Alpha Vantage key at https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=replace_me

# Default stock universe.
TICKERS=AAPL,MSFT,NVDA,AMZN,GOOGL

# Free Alpha Vantage keys should use "compact".
# "full" historical output currently requires a premium Alpha Vantage plan.
ALPHA_VANTAGE_OUTPUT_SIZE=compact

# Local macOS/manual run database URL.
DATABASE_URL=postgresql+psycopg2://etl:etl@localhost:5433/market_data

# Project-local file locations.
RAW_DATA_DIR=./data/raw
LOG_DIR=./logs

# Retry behavior for API calls.
API_MAX_RETRIES=4
API_BACKOFF_SECONDS=2
API_TIMEOUT_SECONDS=30

# Optional integration test switch.
RUN_INTEGRATION_TESTS=false
